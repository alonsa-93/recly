* text=auto

# Windows scripts keep CRLF line endings
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.wasm binary
*.wav binary

# Vendored, minified third-party code: keep out of diffs and language stats
vendor/** linguist-vendored -diff
